#
# 小米 4C (MT7628AN) 超精简固件配置
# 官方固件分区上限 14976 KB (0xEA0000)，但不应占满：
#   - Breed 引导后仍需余量
#   - 剩余空间留给 overlay / opkg 安装软件包
# CI 目标上限见 workflow 中 IMAGE_TARGET_MAX_KB（约 12.5 MB）
#

# --- 目标平台 ---
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_xiaomi_mi-router-4c=y

# --- 体积优化 ---
CONFIG_DEVEL=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mno-branch-likely -mips32r2 -mtune=24kc"
CONFIG_KERNEL_BUILD_USER=""
CONFIG_KERNEL_BUILD_DOMAIN=""
CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_SQUASHFS_FRAGMENT_CACHE_SIZE=2
CONFIG_USE_MKLIBS=y

# 去掉内核调试符号，减小 vmlinux / 模块体积
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_KALLSYMS_ALL is not set

# --- LuCI：轻量版 + Edge2 主题 + 仅基础中文包 ---
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-edge2=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y

# 不装默认 bootstrap 主题
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
# CONFIG_PACKAGE_luci-theme-openwrt-2020 is not set
# CONFIG_PACKAGE_luci is not set

# 仅保留 edge2 主题依赖（体积已计入，无法再去）
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jsonfilter=y

# --- 核心网络 ---
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-swconfig=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# --- 去掉 PPPoE（需要时 opkg install ppp ppp-mod-pppoe） ---
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_luci-proto-ppp is not set

# --- IPv6 ---
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# --- 去掉 USB 驱动（4C 无 USB） ---
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-ehci is not set

# --- 去掉硬件加速模块（省体积，CPU 稍忙） ---
# CONFIG_PACKAGE_kmod-nft-offload is not set

# --- 去掉 LuCI 插件 / 额外 i18n ---
# CONFIG_PACKAGE_luci-lib-ipkg is not set
# CONFIG_PACKAGE_luci-i18n-firewall-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-opkg-zh-cn is not set
# CONFIG_PACKAGE_luci-app-opkg is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-adblock is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-commands is not set
# CONFIG_PACKAGE_luci-app-filetransfer is not set

# --- 去掉编辑器 / 调试工具 ---
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_vim is not set
# CONFIG_PACKAGE_tcpdump is not set
# CONFIG_PACKAGE_iperf3 is not set
# CONFIG_PACKAGE_nmap is not set
# CONFIG_PACKAGE_wget is not set

# --- 默认选中 edge2 主题 ---
CONFIG_DEFAULT_luci-theme-edge2=y
